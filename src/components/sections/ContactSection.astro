<!-- Contact Content Section -->
<section class="contact-content-section relative bg-white py-16 px-4 sm:px-6 lg:px-8 min-h-[50vh]">

  <!-- Top fade from hero (black) to contact (white) -->
  <div
    class="absolute top-0 left-0 right-0 h-40 z-10 pointer-events-none"
    style="background: linear-gradient(to bottom, #000000 0%, rgba(0,0,0,0.6) 30%, rgba(255,255,255,0.4) 70%, #ffffff 100%);"
  ></div>

  <div class="relative z-20 max-w-6xl mx-auto pt-32">
    <!-- Main Contact Card -->
    <div class="contact-main-card mb-12">
      <div class="text-center mb-12">
        <h2 class="contact-section-title text-3xl md:text-4xl font-bold mb-4">
          Any Questions?
        </h2>
        <p class="contact-section-subtitle text-lg md:text-xl opacity-80">
          We'd love to hear from you. Reach out to us via our email below.
        </p>
      </div>

      <div class="contact-card text-center flex flex-col items-center px-4">
        <a
          href="mailto:tourism@gmc.bt"
          class="inline-flex items-center gap-3
                 px-8 py-4
                 rounded-full
                 text-lg md:text-xl font-semibold
                 bg-gray-200 text-gray-900
                 hover:bg-gray-300
                 transition-all duration-200
                 shadow-lg hover:shadow-xl
                 group"
        >
          <i class="fa-solid fa-envelope text-xl"></i>
          <span>tourism@gmc.bt</span>
          <i class="fa-solid fa-arrow-right transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>

    </div>
  </div>
</section>
